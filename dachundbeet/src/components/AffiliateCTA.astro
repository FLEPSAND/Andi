---
import { AFFILIATE } from '../config';
import type { Affiliate } from '../data/rechner';

interface Props { data?: Affiliate }
const { data } = Astro.props;

/**
 * Nur ausspielen, wenn eine echte Partner-URL hinterlegt ist. Solange der
 * Platzhalter '#' drinsteht, würde sonst ein sichtbarer Button ins Leere führen.
 */
const aktiv = Boolean(data?.href && data.href !== '#' && data.href.startsWith('http'));
---

{AFFILIATE.enabled && data && aktiv && (
  <aside class="affil" aria-label="Empfehlung">
    <div class="affil__row">
      <div>
        <div class="affil__head">💡 {data.heading}</div>
        <p class="affil__text">{data.text}</p>
      </div>
      <a
        class="btn btn--terra"
        href={data.href}
        rel="sponsored nofollow noopener"
        target="_blank"
      >{data.cta} →</a>
    </div>
    <p class="affil__disclosure">{AFFILIATE.disclosure}</p>
  </aside>
)}
