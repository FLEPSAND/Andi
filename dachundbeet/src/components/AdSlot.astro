---
import { ADSENSE } from '../config';

interface Props {
  /** AdSense Ad-Slot-ID (data-ad-slot). Vor Launch pro Platzierung eintragen. */
  slot?: string;
  layout?: 'horizontal' | 'rectangle';
  label?: string;
}
const { slot = '', layout = 'horizontal', label = 'Anzeige' } = Astro.props;
const minH = layout === 'rectangle' ? 250 : 90;

/**
 * Ohne freigeschaltetes AdSense (oder ohne Slot-ID) wird gar nichts ausgegeben.
 * Ein sichtbarer Platzhalterrahmen ließe die Seite unfertig wirken — für Besucher
 * wie für die AdSense-Prüfung.
 */
const enabled = ADSENSE.enabled && !!slot;
---

{enabled && (
  <div
    class="adslot"
    data-adslot
    data-ad-client={ADSENSE.publisherId}
    data-ad-slot={slot}
    data-enabled="1"
  >
    <div class="adslot__label">{label}</div>
    <div class="adslot__body" data-adslot-body>
      <div class="adslot__ph" style={`min-height:${minH}px`}>
        Anzeige wird geladen, sobald du der Cookie-Nutzung zustimmst
      </div>
    </div>
  </div>
)}
