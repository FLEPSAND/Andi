---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE } from '../../config';
import { getRechner } from '../../data/rechner';

export async function getStaticPaths() {
  const posts = await getCollection('ratgeber');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE.url}/ratgeber/${post.id}`;
const rechner = post.data.rechner ? getRechner(post.data.rechner) : undefined;

const others = (await getCollection('ratgeber'))
  .filter((p) => p.id !== post.id)
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    inLanguage: 'de-DE',
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: SITE.name },
    publisher: { '@type': 'Organization', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: `${SITE.url}/ratgeber` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
const fmtDate = (d: Date) => new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.description} jsonLd={jsonLd} ogType="article">
  <section class="hero hero--calc">
    <div class="hero__bg"></div>
    <div class="container hero__inner" style="max-width:820px">
      <span class="pill"><span aria-hidden="true">{post.data.icon}</span> {post.data.category}</span>
      <h1 class="mt-2">{post.data.title}</h1>
      <p class="hero__lead">{post.data.description}</p>
    </div>
  </section>

  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrümel">
      <a href="/">Startseite</a> / <a href="/ratgeber">Ratgeber</a> / <span aria-current="page">{post.data.category}</span>
    </nav>
  </div>

  <article class="section container" style="padding-top:0">
    <p class="text-muted" style="font-size:.85rem;margin-bottom:1.5rem">Aktualisiert am {fmtDate(post.data.updated ?? post.data.pubDate)}</p>
    <div class="prose">
      <Content />
    </div>

    {rechner && (
      <aside class="affil" style="margin-top:2.5rem" aria-label="Passender Rechner">
        <div class="affil__row">
          <div>
            <div class="affil__head">{rechner.icon} Jetzt selbst durchrechnen</div>
            <p class="affil__text">Nutze den {rechner.cardTitle} und übertrage die Erkenntnisse aus diesem Artikel direkt auf deine Situation.</p>
          </div>
          <a class="btn btn--primary" href={`/rechner/${rechner.slug}`}>Zum {rechner.cardTitle} →</a>
        </div>
      </aside>
    )}

    <AdSlot slot="" layout="horizontal" />

    {others.length > 0 && (
      <section style="margin-top:1rem">
        <h2 style="font-size:1.4rem;margin-bottom:1.2rem">Weitere Ratgeber</h2>
        <div class="grid grid--3">
          {others.map((p) => (
            <a class="card rcard" href={`/ratgeber/${p.id}`}>
              <span class="rcard__icon" aria-hidden="true">{p.data.icon}</span>
              <span class="pill rcard__tag">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <span class="rcard__more">Weiterlesen →</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
