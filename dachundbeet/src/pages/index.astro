---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RechnerCard from '../components/RechnerCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config';
import { RECHNER, categories, rechnerByCategory } from '../data/rechner';

const posts = (await getCollection('ratgeber'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'de-DE',
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    slogan: SITE.tagline,
  },
];
---

<BaseLayout title={`${SITE.name} – Rechner für Haus, Energie & Garten`} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero hero--home">
    <div class="hero__bg"></div>
    <div class="container hero__inner">
      <span class="pill">{SITE.tagline}</span>
      <h1 class="hero__title mt-2">Rechnen, das dir <span class="accent">Klarheit</span> bringt.</h1>
      <p class="hero__lead">
        Kostenlose, präzise Rechner für Solar, Wärmepumpe, Energiekosten und Garten –
        sofort im Browser, ohne Anmeldung. Damit du Entscheidungen mit Zahlen triffst, nicht mit Bauchgefühl.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/rechner">Alle Rechner ansehen</a>
        <a class="btn btn--ghost" href="/rechner/pv-solar">Photovoltaik berechnen</a>
      </div>

      <div class="stats">
        <div><div class="stat__num">{RECHNER.length}</div><div class="stat__label">Rechner</div></div>
        <div><div class="stat__num">100 %</div><div class="stat__label">Kostenlos</div></div>
        <div><div class="stat__num">0</div><div class="stat__label">Anmeldung nötig</div></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <span class="pill pill--terra">Beliebte Rechner</span>
      <h2 class="mt-2">Direkt loslegen</h2>
      <p class="text-muted">Alle Ergebnisse werden lokal in deinem Browser berechnet – deine Eingaben verlassen dein Gerät nicht.</p>
    </div>
    <div class="grid grid--3">
      {RECHNER.map((r) => <RechnerCard rechner={r} />)}
    </div>
  </section>

  <div class="container"><AdSlot slot="" layout="horizontal" /></div>

  <section class="section container">
    {categories().map((cat) => (
      <div style="margin-bottom:2rem">
        <h2 style="font-size:1.3rem;margin-bottom:1rem">{cat}</h2>
        <div class="grid grid--3">
          {rechnerByCategory(cat).map((r) => <RechnerCard rechner={r} />)}
        </div>
      </div>
    ))}
  </section>

  {posts.length > 0 && (
    <section class="section container" style="padding-top:0">
      <div class="section-head">
        <span class="pill pill--terra">Ratgeber</span>
        <h2 class="mt-2">Wissen, das sich rechnet</h2>
        <p class="text-muted">Verständliche Artikel rund um Energie, Haus und Garten – mit passendem Rechner zum Nachrechnen.</p>
      </div>
      <div class="grid grid--3">
        {posts.map((p) => (
          <a class="card rcard" href={`/ratgeber/${p.id}`}>
            <span class="rcard__icon" aria-hidden="true">{p.data.icon}</span>
            <span class="pill rcard__tag">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="rcard__more">Weiterlesen →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container grid grid--3">
      <div class="card">
        <h3>🎯 Präzise gerechnet</h3>
        <p class="text-muted">Nachvollziehbare Formeln statt Blackbox. Jeder Rechner erklärt, wie er rechnet – und wo die Grenzen liegen.</p>
      </div>
      <div class="card">
        <h3>⚡ Sofort & lokal</h3>
        <p class="text-muted">Kein Warten, kein Login, keine Datenweitergabe. Die Berechnung passiert direkt in deinem Browser.</p>
      </div>
      <div class="card">
        <h3>🇩🇪 Auf Deutschland zugeschnitten</h3>
        <p class="text-muted">Einspeisevergütung, Förderungen und typische Verbrauchswerte – abgestimmt auf den deutschen Markt.</p>
      </div>
    </div>
  </section>
</BaseLayout>
