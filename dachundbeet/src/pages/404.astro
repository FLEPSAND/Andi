---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht.">
  <section class="section container center">
    <span class="pill pill--terra">Fehler 404</span>
    <h1 class="mt-2">Diese Seite gibt es nicht</h1>
    <p class="text-muted mt-2">Vielleicht hilft dir einer unserer Rechner weiter?</p>
    <div class="hero__cta" style="justify-content:center;margin-top:1.5rem">
      <a class="btn btn--primary" href="/">Zur Startseite</a>
      <a class="btn btn--ghost" href="/rechner">Alle Rechner</a>
    </div>
  </section>
</BaseLayout>
