---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="Impressum" description={`Impressum und Anbieterkennzeichnung von ${SITE.name}.`}>
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrümel"><a href="/">Startseite</a> / <span aria-current="page">Impressum</span></nav>
  </div>
  <section class="section container" style="padding-top:0">
    <div class="prose">
      <h1>Impressum</h1>

      <div class="card" style="border-color:var(--terra);background:var(--terra-soft)">
        <strong>Hinweis:</strong> Diese Angaben stammen von dir (private, nicht-gewerbliche Nutzung).
        Meldest du später ein Gewerbe an oder wirst du umsatzsteuerpflichtig, ergänze zusätzlich
        Gewerbe-/USt-IdNr.-Angaben. Lass das Impressum im Zweifel einmal rechtlich prüfen.
      </div>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        Andreas Fleps<br />
        Schwärzweg 60<br />
        74219 Möckmühl<br />
        Deutschland
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:andreas.fleps@proton.me">andreas.fleps@proton.me</a>
      </p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>Andreas Fleps, Anschrift wie oben</p>

      <h2>Haftung für Inhalte</h2>
      <p>Die Inhalte dieser Seiten wurden mit größter Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte – insbesondere der Rechenergebnisse – können wir jedoch keine Gewähr übernehmen. Die Rechner dienen der unverbindlichen Orientierung.</p>

      <h2>Haftung für Links</h2>
      <p>Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir keinen Einfluss haben. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter verantwortlich.</p>

      <h2>Urheberrecht</h2>
      <p>Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem deutschen Urheberrecht.</p>
    </div>
  </section>
</BaseLayout>
